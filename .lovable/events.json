{
  "schema_version": 1,
  "events": {
    "project.account_created": {
      "event_schema_version": 1,
      "description": "A visitor successfully submitted the registration form and an account was created.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "entry_route"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "entry_route": {
            "type": "string"
          },
          "confirmation_pending": {
            "type": "boolean"
          }
        }
      }
    },
    "project.account_signed_in": {
      "event_schema_version": 1,
      "description": "A player successfully signed in from the sign-in page (password, email code, passkey, phone or in-page provider).",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "entry_route"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "entry_route": {
            "type": "string"
          }
        }
      }
    },
    "project.match_started": {
      "event_schema_version": 1,
      "description": "A player confirmed and began a match, from career match preparation or from quick match.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "entry"
        ],
        "properties": {
          "career_id": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "career",
              "quick"
            ]
          },
          "entry": {
            "type": "string",
            "enum": [
              "match_preparation",
              "quick_match"
            ]
          }
        }
      }
    },
    "project.store_checkout_started": {
      "event_schema_version": 1,
      "description": "A player picked a store product and the secure checkout session was created successfully.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_key",
          "price_cents",
          "currency",
          "checkout_mode"
        ],
        "properties": {
          "product_key": {
            "type": "string"
          },
          "price_cents": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "type": "string"
          },
          "checkout_mode": {
            "type": "string",
            "enum": [
              "account",
              "guest"
            ]
          }
        }
      }
    }
  }
}
