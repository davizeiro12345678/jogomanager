import { writeFileSync } from "node:fs";
import { BUNDLED_LEAGUES } from "../src/game/data/leagues.ts";
import { LANGS } from "../src/i18n/locale-identifiers.ts";

// node --import tsx scripts/generate-quick-country-order.mts
// Precompute shared collation only; unusual locales and custom countries still
// use the platform collator. Tests compare every supported locale with Intl.
const countries = [...new Set(BUNDLED_LEAGUES.map((league) => league.country))];
const ordered = (lang: string) => {
  const compare = new Intl.Collator(lang).compare;
  return [...countries].sort((a, b) => (a === "Brasil" ? -1 : b === "Brasil" ? 1 : compare(a, b)));
};
const common = ordered("pt-BR");
const exceptions = LANGS.filter((lang) => ordered(lang).join("\n") !== common.join("\n"));
const indices = common.map((country) => BUNDLED_LEAGUES.findIndex((l) => l.country === country));
writeFileSync(
  new URL("../src/game/quick-country-order.generated.ts", import.meta.url),
  `// Generated by scripts/generate-quick-country-order.mts; verify all locales before release.\nexport const COUNTRY_ORDER = ${JSON.stringify(indices)};\nexport const COUNTRY_COLLATION_EXCEPTIONS = new Set<string>(${JSON.stringify(exceptions)});\n`,
);
