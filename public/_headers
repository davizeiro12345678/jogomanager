# Applies to Cloudflare Workers static assets only. SSR and API responses
# are handled by secureResponse() in src/lib/security-headers.ts.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), usb=()
