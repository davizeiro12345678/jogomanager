# Rebuild the upstream 1.12.1 release with a patched Go toolchain and Go modules.
FROM golang:1.27.3-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS build
RUN apk add --no-cache bash git python3
RUN git clone --depth 1 --branch v1.12.1 https://github.com/prometheus/node_exporter.git /src
WORKDIR /src
RUN test "$(git rev-parse HEAD)" = "6044da783597cc3b57aef7580ddcdcff58a4ee99"
ENV GOTOOLCHAIN=local CGO_ENABLED=0 GOMAXPROCS=2
RUN go get golang.org/x/crypto@v0.57.0 golang.org/x/net@v0.60.0
RUN ./ttar -C collector/fixtures -x -f collector/fixtures/sys.ttar
RUN ./ttar -C collector/fixtures -x -f collector/fixtures/udev.ttar
RUN go test -p 2 -timeout 5m ./...
RUN go build -p 2 -trimpath -ldflags "-X github.com/prometheus/common/version.Version=1.12.1-pfm1 -X github.com/prometheus/common/version.Revision=6044da783597cc3b57aef7580ddcdcff58a4ee99" -o /out/node_exporter .

FROM prom/node-exporter:v1.12.1@sha256:1b4e4438faca4dd7e001dd445d161a4a2091b0fededa84093b3a8dfeae1f1be0
COPY --from=build /out/node_exporter /bin/node_exporter
USER 65534:65534
