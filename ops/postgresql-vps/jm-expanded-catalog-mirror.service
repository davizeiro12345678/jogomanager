[Unit]
Description=JogoManager extended public football catalog mirror
Wants=network-online.target postgresql@18-main.service
After=network-online.target postgresql@18-main.service

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=/etc/jogomanager/supabase-public.env
ExecStart=/usr/bin/python3 /opt/jm-postgres-mirror/sync_public_catalog.py --tables stadiums kits competition_seasons official_teams official_venues official_players
Nice=12
CPUQuota=40%
MemoryMax=768M
TimeoutStartSec=1800
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/postgresql
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
